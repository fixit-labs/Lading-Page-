# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chatwoot API Configuration for support tickets
# Get these from your Chatwoot instance
CHATWOOT_API_URL=https://chatwoot-production-6798.up.railway.app
CHATWOOT_API_TOKEN=your_api_access_token_here
CHATWOOT_INBOX_ID=your_inbox_identifier_here
